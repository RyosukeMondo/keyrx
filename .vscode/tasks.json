{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Verify Dart Bindings",
      "type": "shell",
      "command": "python3",
      "args": [
        "scripts/verify/bindings.py"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "Build Rust Core",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "-p",
        "keyrx_core",
        "--lib"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": [
        "Verify Dart Bindings"
      ],
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Generate Dart Bindings",
      "type": "shell",
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--manifest-path",
        "core/tools/generate_dart_bindings/Cargo.toml",
        "--",
        "--output",
        "packages/core_logic/lib",
        "--ipc-output",
        "ui/lib",
        "--verbose"
      ],
      "problemMatcher": []
    }
  ]
}
