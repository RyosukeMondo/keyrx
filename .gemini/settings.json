{
  "mcpServers": {
    "spec-workflow": {
      "command": "npx",
      "args": [
        "@pimzino/spec-workflow-mcp@latest"
      ]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "/home/rmondo/repos/keyrx",
        "--enable-web-dashboard",
        "False"
      ]
    }
  }
}