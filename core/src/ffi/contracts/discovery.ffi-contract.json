{
  "$schema": "https://keyrx.dev/schemas/ffi-contract.schema.json",
  "version": "1.0.0",
  "domain": "discovery",
  "description": "Device discovery and capability reporting contract",
  "protocol_version": 1,
  "functions": [
    {
      "name": "start_discovery",
      "description": "Start USB HID discovery and return discovered devices",
      "parameters": [
        {
          "name": "timeout_ms",
          "type": "u32",
          "description": "Maximum time to scan for devices",
          "required": true,
          "constraints": {
            "min": 0,
            "max": 60000
          }
        }
      ],
      "returns": {
        "type": "array",
        "description": "List of discovered devices",
        "items": {
          "type": "object",
          "description": "Discovered device identity",
          "properties": {
            "vendor_id": { "type": "u16", "description": "USB vendor id" },
            "product_id": { "type": "u16", "description": "USB product id" },
            "manufacturer": { "type": "string", "description": "Manufacturer name" },
            "name": { "type": "string", "description": "Product name" }
          }
        }
      },
      "errors": [
        {
          "code": "DISCOVERY_ERROR",
          "description": "Discovery failed"
        },
        {
          "code": "INVALID_PARAMETER",
          "description": "Invalid timeout"
        }
      ],
      "events_emitted": ["device_found"],
      "example": {
        "input": { "timeout_ms": 5000 },
        "output": [
          {
            "vendor_id": 4660,
            "product_id": 22136,
            "manufacturer": "KeyRx",
            "name": "Revolutionary Keyboard"
          }
        ]
      }
    }
  ],
  "types": {
    "DiscoveredDevice": {
      "type": "object",
      "description": "Basic device identity and metadata",
      "properties": {
        "vendor_id": { "type": "u16" },
        "product_id": { "type": "u16" },
        "manufacturer": { "type": "string" },
        "name": { "type": "string" }
      }
    }
  },
  "events": [
    {
      "name": "device_found",
      "description": "Emitted when a device is discovered",
      "payload": {
        "type": "object",
        "properties": {
          "vendor_id": { "type": "u16" },
          "product_id": { "type": "u16" }
        }
      }
    }
  ]
}
