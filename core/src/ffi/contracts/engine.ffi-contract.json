{
  "$schema": "https://keyrx.dev/schemas/ffi-contract.schema.json",
  "version": "1.0.0",
  "domain": "engine",
  "description": "Core engine lifecycle and control contract",
  "protocol_version": 1,
  "functions": [
    {
      "name": "on_state",
      "rust_name": "keyrx_on_state",
      "description": "Register callback for engine state updates",
      "parameters": [
        {
          "name": "callback",
          "type": "Option<unsafe extern \"C\" fn(*const u8, usize)>",
          "description": "Callback function pointer for state updates, or NULL to unregister",
          "required": false
        }
      ],
      "returns": {
        "type": "void",
        "description": "None"
      },
      "errors": [],
      "events_emitted": []
    },
    {
      "name": "start_loop",
      "rust_name": "keyrx_engine_start_loop",
      "description": "Start the event processing loop",
      "parameters": [],
      "returns": {
        "type": "i32",
        "description": "0 on success, -1 if already running"
      },
      "errors": [
        {
          "code": "INVALID_PROFILE",
          "description": "Profile could not be loaded"
        },
        {
          "code": "ENGINE_ERROR",
          "description": "Engine failed to start"
        }
      ],
      "events_emitted": ["engine_started"]
    },
    {
      "name": "stop_loop",
      "rust_name": "keyrx_engine_stop_loop",
      "description": "Stop the event processing loop",
      "parameters": [],
      "returns": {
        "type": "i32",
        "description": "0 on success, -1 if not running"
      },
      "errors": [
        {
          "code": "ENGINE_ERROR",
          "description": "Engine failed to stop"
        }
      ],
      "events_emitted": ["engine_stopped"]
    }
  ],
  "types": {},
  "events": [
    {
      "name": "engine_started",
      "description": "Emitted after the engine loop starts",
      "payload": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "description": "Start time in RFC3339" }
        }
      }
    },
    {
      "name": "engine_stopped",
      "description": "Emitted after the engine loop stops",
      "payload": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "description": "Stop time in RFC3339" }
        }
      }
    }
  ]
}
