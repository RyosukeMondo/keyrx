# keyrx - Keyboard remapping daemon systemd service (User Service)
# =================================================================
#
# This is a user-level systemd service for running keyrx daemon
# without root privileges. User services are managed per-user and
# start when the user logs in (with lingering enabled).
#
# WHEN TO USE THIS VS SYSTEM SERVICE:
#   - User service: Single user desktop, per-user configuration
#   - System service: Multi-user systems, system-wide configuration
#
# PREREQUISITES:
#   1. Install udev rules (see keyrx_daemon/udev/99-keyrx.rules)
#   2. Add your user to required groups: sudo usermod -aG input,uinput $USER
#   3. Log out and log back in (or: newgrp input && newgrp uinput)
#   4. Ensure uinput module is loaded: sudo modprobe uinput
#
# INSTALLATION:
#   1. Create user systemd directory:
#      mkdir -p ~/.config/systemd/user
#
#   2. Copy this file to user systemd directory:
#      cp keyrx-user.service ~/.config/systemd/user/keyrx.service
#
#   3. Copy the daemon binary:
#      mkdir -p ~/.local/bin
#      cp target/release/keyrx_daemon ~/.local/bin/
#
#   4. Create configuration directory:
#      mkdir -p ~/.config/keyrx
#
#   5. Pick the profile to run (web UI at http://127.0.0.1:9867, or CLI):
#      keyrx_daemon profiles create my --template blank
#      keyrx_daemon profiles activate my
#      The service runs the ACTIVE profile (~/.config/keyrx/.active). Activating
#      another profile later switches the running daemon immediately and is
#      remembered across restarts. (`run --config FILE` pins a file instead.)
#
#   6. Reload user systemd and enable the service:
#      systemctl --user daemon-reload
#      systemctl --user enable keyrx.service
#      systemctl --user start keyrx.service
#
#   7. (Optional) Enable lingering to start service at boot without login:
#      loginctl enable-linger $USER
#
# USAGE:
#   Start:    systemctl --user start keyrx
#   Stop:     systemctl --user stop keyrx
#   Restart:  systemctl --user restart keyrx
#   Reload:   systemctl --user reload keyrx  (re-reads the active profile)
#   Status:   systemctl --user status keyrx
#   Logs:     journalctl --user -u keyrx -f
#
# TROUBLESHOOTING:
#   - Check status: systemctl --user status keyrx
#   - View logs: journalctl --user -u keyrx --no-pager -n 50
#   - Which profile is live: ~/.local/bin/keyrx_daemon status
#   - List devices: ~/.local/bin/keyrx_daemon list-devices
#   - Check permissions: ls -la /dev/input/event* /dev/uinput
#   - Verify group membership: groups $USER
#   - Check lingering status: loginctl show-user $USER | grep Linger
#
# NOTE ON WAYLAND:
#   Under Wayland, keyboard remapping at the evdev level works globally
#   across all applications. This is different from X11-based remapping
#   which may not work in all contexts.
#
# Tested on: Ubuntu 22.04+, Fedora 38+, Arch Linux (rolling)

[Unit]
Description=keyrx Keyboard Remapping Daemon (User Service)
Documentation=https://github.com/keyrx/keyrx

# Started by default.target: at boot when lingering is enabled, otherwise at
# login. It deliberately does NOT wait for graphical-session.target - the
# daemon needs only /dev/input and /dev/uinput (hotplug picks up keyboards that
# appear later), and waiting would leave the keyboard unremapped until login.
# The tray icon needs the session's DISPLAY/WAYLAND_DISPLAY: when the daemon
# starts before login it runs without a tray (the web UI works either way);
# `systemctl --user restart keyrx` after login brings the tray up.
# EMERGENCY STOP: hold Left Ctrl + Right Ctrl + Escape (works on the raw keys,
# stops the daemon cleanly, which systemd does not restart).

# Never give up restarting. A start can fail simply because the machine is not
# ready yet (e.g. /dev/uinput still owned by root:root until udev has applied
# the rules, or the 'uinput' group not yet effective), and a rate limit that
# trips after 5 failures in 30 s would leave the keyboard unremapped until the
# user notices and restarts the unit by hand. The restart delay below grows
# instead, so a permanent failure costs one log line every 10 s, not a loop.
StartLimitIntervalSec=0

[Service]
Type=simple

# Main daemon command: follow the active profile (no --config, so a profile
# activated in the UI/CLI survives restarts).
# %h expands to user's home directory
ExecStart=%h/.local/bin/keyrx_daemon run

# On stop/restart signal only the daemon itself, not everything in the unit's
# cgroup. The tray's "Open Web UI" runs `xdg-open`, which can start the user's
# browser as a child that systemd then counts as part of this unit; with the
# default KillMode=control-group, `systemctl --user restart keyrx` would close
# that browser and all its tabs.
KillMode=process

# Reload configuration on SIGHUP (systemctl --user reload keyrx)
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy: retry after any non-zero exit (a clean exit, such as the
# emergency stop, is deliberately NOT restarted). The delay starts at 1 s and
# steps up to 10 s over 5 restarts (needs systemd 254+; older versions ignore
# the two keys with a warning and keep a flat 1 s delay).
Restart=on-failure
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=10

# Debug logging: `run --debug` turns on keyrx's own debug output (never the
# names of the keys you type; that needs the separate, privacy-sensitive
# `--log-keys`). RUST_LOG, when set, overrides that filter. To change the
# flags, override ExecStart via a drop-in:
#   systemctl --user edit keyrx
#   [Service]
#   ExecStart=
#   ExecStart=%h/.local/bin/keyrx_daemon run --debug
# Edits to the loaded profile's .rhai are applied automatically (see
# `run --help`, --no-watch).

[Install]
WantedBy=default.target
