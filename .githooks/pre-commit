#!/usr/bin/env bash
#
# Pre-commit hook: enforces code quality before commits
# Runs: cargo fmt --check, cargo clippy, cargo test --lib, Dart toolchain check
#

set -e

# Find repository root by looking for .git directory
find_repo_root() {
    local dir="$1"
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/.git" ]]; then
            echo "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(find_repo_root "$SCRIPT_DIR")"

if [[ -z "$REPO_ROOT" ]]; then
    echo "Error: Could not find repository root" >&2
    exit 1
fi

CORE_DIR="$REPO_ROOT/core"
UI_DIR="$REPO_ROOT/ui"

# Change to core directory for cargo commands
cd "$CORE_DIR"

echo ""
echo "╔════════════════════════════════════════════════════════════╗"
echo "║                   Pre-commit Checks                        ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""

TOTAL_CHECKS=6
if [[ -d "$UI_DIR" ]]; then
    TOTAL_CHECKS=$((TOTAL_CHECKS + 4))
fi
PASSED_CHECKS=0
STEP=1

# Step 1: FFI Contract Validation
echo "[$STEP/$TOTAL_CHECKS] Validating FFI contracts..."
if ! "$REPO_ROOT/scripts/ffi/validate_contracts.sh"; then
    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║  ❌ FAILED: FFI Contract Validation                        ║"
    echo "╠════════════════════════════════════════════════════════════╣"
    echo "║  FFI contracts are out of sync with Rust code.             ║"
    echo "║                                                            ║"
    echo "║  To fix, run:                                              ║"
    echo "║    ./scripts/ffi/validate_contracts.sh --fix               ║"
    echo "║                                                            ║"
    echo "║  Or manually regenerate contracts:                         ║"
    echo "║    just gen-dart-bindings                                  ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    exit 1
fi
PASSED_CHECKS=$((PASSED_CHECKS + 1))
STEP=$((STEP + 1))
echo "    ✓ FFI Contracts OK"
echo ""

# Step 2: Module size guard
echo "[$STEP/$TOTAL_CHECKS] Checking Rust module sizes..."
if ! "$REPO_ROOT/scripts/metrics/module_sizes.sh"; then
    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║  ❌ FAILED: Module size check                              ║"
    echo "╠════════════════════════════════════════════════════════════╣"
    echo "║  Some Rust modules exceed the size limit.                  ║"
    echo "║                                                            ║"
    echo "║  Review .spec-workflow/analysis/module-sizes.json for      ║"
    echo "║  details. If this is a temporary exception, update         ║"
    echo "║  .spec-workflow/config/module-size-allowlist.json with a   ║"
    echo "║  reason and rerun.                                         ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    exit 1
fi
PASSED_CHECKS=$((PASSED_CHECKS + 1))
STEP=$((STEP + 1))
echo "    ✓ Module sizes OK"
echo ""

# Step 3: Format check
echo "[$STEP/$TOTAL_CHECKS] Checking code formatting..."
if ! cargo fmt --check 2>/dev/null; then
    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║  ❌ FAILED: Code formatting check                          ║"
    echo "╠════════════════════════════════════════════════════════════╣"
    echo "║  Your code has formatting issues.                          ║"
    echo "║                                                            ║"
    echo "║  To fix, run:                                              ║"
    echo "║    cd core && cargo fmt                                    ║"
    echo "║                                                            ║"
    echo "║  Or use just:                                              ║"
    echo "║    just fmt                                                ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    exit 1
fi
PASSED_CHECKS=$((PASSED_CHECKS + 1))
STEP=$((STEP + 1))
echo "    ✓ Formatting OK"
echo ""

# Step 4: Clippy lint check
echo "[$STEP/$TOTAL_CHECKS] Running clippy lints..."
if ! cargo clippy --quiet -- -D warnings 2>&1; then
    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║  ❌ FAILED: Clippy lint check                              ║"
    echo "╠════════════════════════════════════════════════════════════╣"
    echo "║  Clippy found warnings that must be fixed.                 ║"
    echo "║                                                            ║"
    echo "║  Review the warnings above and fix them, or use:           ║"
    echo "║    just clippy                                             ║"
    echo "║                                                            ║"
    echo "║  For specific fixes, check clippy documentation:           ║"
    echo "║    https://rust-lang.github.io/rust-clippy/                ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    exit 1
fi
PASSED_CHECKS=$((PASSED_CHECKS + 1))
STEP=$((STEP + 1))
echo "    ✓ Clippy OK"
echo ""

# Step 5: Unit tests (lib only for speed)
echo "[$STEP/$TOTAL_CHECKS] Running unit tests..."
# Force single-threaded execution to avoid flaky global state interactions in docs registry
if ! RUST_TEST_THREADS=1 cargo test --lib --quiet -- --test-threads=1 2>&1; then
    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║  ❌ FAILED: Unit tests                                     ║"
    echo "╠════════════════════════════════════════════════════════════╣"
    echo "║  Some tests are failing.                                   ║"
    echo "║                                                            ║"
    echo "║  To run tests with output:                                 ║"
    echo "║    cd core && cargo test --lib                             ║"
    echo "║                                                            ║"
    echo "║  Or use just:                                              ║"
    echo "║    just test                                               ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    exit 1
fi
PASSED_CHECKS=$((PASSED_CHECKS + 1))
STEP=$((STEP + 1))
echo "    ✓ Tests OK"
echo ""

# Step 6: Verify FFI bindings
echo "[$STEP/$TOTAL_CHECKS] Verifying FFI bindings..."
# Generator is currently incompatible with legacy bindings structure.
# Skipping verification until migration is complete.
# if ! python3 "$REPO_ROOT/scripts/ffi/verify_bindings.py"; then
#     echo ""
#     echo "╔════════════════════════════════════════════════════════════╗"
#     echo "║  ❌ FAILED: FFI Bindings Verification                      ║"
#     echo "╠════════════════════════════════════════════════════════════╣"
#     echo "║  Dart FFI bindings are out of sync with Rust exports.      ║"
#     echo "║                                                            ║"
#     echo "║  To fix, run:                                              ║"
#     echo "║    just gen-bindings                                       ║"
#     echo "║                                                            ║"
#     echo "║  Then add the updated files to your commit.                ║"
#     echo "╚════════════════════════════════════════════════════════════╝"
#     exit 1
# fi
echo "    ⚠ Bindings check skipped (migration pending)"
echo ""

if [[ -d "$UI_DIR" ]]; then
    UI_COVERAGE_THRESHOLD="${UI_COVERAGE_THRESHOLD:-60}"
    # Step 7: Dart/Flutter toolchain availability
    echo "[$STEP/$TOTAL_CHECKS] Checking Dart/Flutter toolchain..."
    if ! command -v dart >/dev/null 2>&1; then
        echo ""
        echo "╔════════════════════════════════════════════════════════════╗"
        echo "║  ❌ FAILED: Dart toolchain missing                         ║"
        echo "╠════════════════════════════════════════════════════════════╣"
        echo "║  Dart/Flutter commands are required for UI checks.         ║"
        echo "║                                                            ║"
        echo "║  To install Flutter (which bundles Dart):                  ║"
        echo "║    https://docs.flutter.dev/get-started/install            ║"
        echo "║                                                            ║"
        echo "║  After installation, ensure 'dart' is on your PATH.        ║"
        echo "╚════════════════════════════════════════════════════════════╝"
        exit 1
    fi

    if ! command -v flutter >/dev/null 2>&1; then
        echo ""
        echo "╔════════════════════════════════════════════════════════════╗"
        echo "║  ❌ FAILED: Flutter CLI missing                            ║"
        echo "╠════════════════════════════════════════════════════════════╣"
        echo "║  Flutter is needed for upcoming UI checks.                 ║"
        echo "║                                                            ║"
        echo "║  Install Flutter from:                                     ║"
        echo "║    https://docs.flutter.dev/get-started/install            ║"
        echo "║                                                            ║"
        echo "║  Verify with:                                              ║"
        echo "║    flutter --version                                       ║"
        echo "╚════════════════════════════════════════════════════════════╝"
        exit 1
    fi

    pushd "$UI_DIR" >/dev/null
    echo "    ✓ Dart/Flutter toolchain detected (UI checks ready)"
    popd >/dev/null
    PASSED_CHECKS=$((PASSED_CHECKS + 1))
    STEP=$((STEP + 1))

    # Step 8: Dart format check
    echo "[$STEP/$TOTAL_CHECKS] Checking Dart formatting..."
    pushd "$UI_DIR" >/dev/null
    if ! dart format --set-exit-if-changed .; then
        echo ""
        echo "╔════════════════════════════════════════════════════════════╗"
        echo "║  ❌ FAILED: Dart formatting check                          ║"
        echo "╠════════════════════════════════════════════════════════════╣"
        echo "║  Dart files need formatting.                               ║"
        echo "║                                                            ║"
        echo "║  To fix, run:                                              ║"
        echo "║    cd ui && dart format .                                  ║"
        echo "╚════════════════════════════════════════════════════════════╝"
        popd >/dev/null
        exit 1
    fi
    popd >/dev/null
    PASSED_CHECKS=$((PASSED_CHECKS + 1))
    STEP=$((STEP + 1))
    echo "    ✓ Dart formatting OK"
    echo ""

    # Step 9: Flutter analyze with fatal infos
    echo "[$STEP/$TOTAL_CHECKS] Running flutter analyze (fatal infos)..."
    pushd "$UI_DIR" >/dev/null
    STAGED_DART_FILES=$(git -C "$REPO_ROOT" diff --cached --name-only -- '*.dart' | grep '^ui/' || true)
    if [[ -z "$STAGED_DART_FILES" ]]; then
        echo "    ✓ No staged Dart files to analyze (skipping)"
    else
        # Strip ui/ prefix so paths are relative to UI_DIR
        mapfile -t ANALYZE_FILES < <(printf '%s\n' "$STAGED_DART_FILES" | sed 's#^ui/##')
        if ! flutter analyze --fatal-infos "${ANALYZE_FILES[@]}"; then
            echo ""
            echo "╔════════════════════════════════════════════════════════════╗"
            echo "║  ❌ FAILED: Flutter analyze (--fatal-infos)                ║"
            echo "╠════════════════════════════════════════════════════════════╣"
            echo "║  Dart analysis found issues (including infos as errors).   ║"
            echo "║                                                            ║"
            echo "║  To reproduce, run:                                        ║"
            echo "║    cd ui && flutter analyze --fatal-infos ${ANALYZE_FILES[*]}"
            echo "║                                                            ║"
            echo "║  Fix the reported problems before committing.              ║"
            echo "╚════════════════════════════════════════════════════════════╝"
            popd >/dev/null
            exit 1
        fi
    fi
    popd >/dev/null
    PASSED_CHECKS=$((PASSED_CHECKS + 1))
    STEP=$((STEP + 1))
    echo "    ✓ Flutter analyze OK"
    echo ""

    # Step 10: Flutter tests with coverage (fast suite)
    FAST_TEST_FILES="${UI_TEST_FILES:-test/services/keymap_converter_test.dart}"
    FAST_COVERAGE_THRESHOLD="${UI_FAST_COVERAGE_THRESHOLD:-0}"
    echo "[$STEP/$TOTAL_CHECKS] Running flutter test with coverage (fast suite, threshold ${FAST_COVERAGE_THRESHOLD}% )..."
    pushd "$UI_DIR" >/dev/null
    if ! TEST_FILES="$FAST_TEST_FILES" COVERAGE_THRESHOLD="$FAST_COVERAGE_THRESHOLD" "$UI_DIR/scripts/check_coverage.sh"; then
        echo ""
        echo "╔════════════════════════════════════════════════════════════╗"
        echo "║  ❌ FAILED: Flutter tests with coverage                    ║"
        echo "╠════════════════════════════════════════════════════════════╣"
        echo "║  The fast Flutter test suite failed or coverage below      ║"
        echo "║  the required threshold (${FAST_COVERAGE_THRESHOLD}%).     ║"
        echo "║                                                            ║"
        echo "║  To reproduce, run:                                        ║"
        echo "║    cd ui && COVERAGE_THRESHOLD=${UI_COVERAGE_THRESHOLD} \\  ║"
        echo "║      ./scripts/check_coverage.sh                           ║"
        echo "║                                                            ║"
        echo "║  Keep this suite fast-only; skip slow/integration cases.   ║"
        echo "║  Raise UI_COVERAGE_THRESHOLD as quality improves (goal 80%).║"
        echo "╚════════════════════════════════════════════════════════════╝"
        popd >/dev/null
        exit 1
    fi
    popd >/dev/null
    PASSED_CHECKS=$((PASSED_CHECKS + 1))
    STEP=$((STEP + 1))
    echo "    ✓ Flutter tests with coverage OK"
    echo ""
fi

echo "╔════════════════════════════════════════════════════════════╗"
echo "║  ✅ All $PASSED_CHECKS/$TOTAL_CHECKS pre-commit checks passed!                       ║"
echo "║                                                            ║"
echo "║  Checks completed:                                         ║"
echo "║    • FFI contract validation                               ║"
echo "║    • Module size check                                     ║"
echo "║    • cargo fmt --check                                     ║"
echo "║    • cargo clippy -- -D warnings                           ║"
echo "║    • cargo test --lib                                      ║"
echo "║    • python3 scripts/verify_bindings.py                    ║"
if [[ -d "$UI_DIR" ]]; then
    echo "║    • Dart/Flutter toolchain availability                   ║"
    echo "║    • dart format --set-exit-if-changed (ui)                ║"
    echo "║    • flutter analyze --fatal-infos (ui)                    ║"
    echo "║    • flutter test --coverage (fast suite, ui, threshold ${FAST_COVERAGE_THRESHOLD}%)║"
fi
echo "╚════════════════════════════════════════════════════════════╝"
echo ""
